{{setTitle 'Add Match'}}

<main class="create">
  <section id="create">
    <div class="form">
      <h2>⚽ Add Match</h2>
      <form class="create-form" action="#" method="POST">
        <label>Home Team</label>
        <input type="text" id="home-team" name="homeTeam" placeholder="e.g. Brazil" value="{{data.homeTeam}}" />
        <label>Away Team</label>
        <input type="text" id="away-team" name="awayTeam" placeholder="e.g. Argentina" value="{{data.awayTeam}}" />
        <label>Home Goals</label>
        <input type="number" id="home-goals" name="homeGoals" placeholder="0" min="0" value="{{data.homeGoals}}" />
        <label>Away Goals</label>
        <input type="number" id="away-goals" name="awayGoals" placeholder="0" min="0" value="{{data.awayGoals}}" />
        <label>Stage</label>
        <select id="stage" name="stage">
          <option value="">Select stage...</option>
          {{#each options}}
          <option value="{{value}}" {{isSelected}}>{{label}}</option>
          {{/each}}
        </select>
        <label>Venue</label>
        <input type="text" id="venue" name="venue" placeholder="e.g. MetLife Stadium, New York"
          value="{{data.venue}}" />
        <label>Match Date</label>
        <input type="text" id="date" name="date" placeholder="DD/MM/YYYY" value="{{data.date}}" />
        <label>Image URL</label>
        <input type="text" id="obs-img" name="imageUrl" placeholder="https://..." value="{{data.imageUrl}}" />
        <label>Match Report</label>
        <textarea id="description" name="description"
          placeholder="Describe the match...">{{data.description}}</textarea>
        <button type="submit">Add Match</button>
      </form>
    </div>
  </section>
</main>